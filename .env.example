# 1. BẢO MẬT XÁC THỰC (BẮT BUỘC TRÊN PRODUCTION)
AUTH_SECRET=dichvutaichinh_secret_jwt_key_2026_vib_minhthucmkt_prod
ADMIN_ALLOWED_EMAILS=admin@minhthucmkt.vn

# 2. CƠ SỞ DỮ LIỆU (TÙY CHỌN - MẶC ĐỊNH SỬ DỤNG PERSISTENT LOCAL FILE AT data/cms_store.json)
DATABASE_URL="file:./data/cms_store.json"

# 3. HẠ TẦNG THƯ VIỆN MEDIA STORAGE (TÙY CHỌN S3 / CLOUDFLARE R2 / MINIO / LOCAL)
# Mặc định sử dụng local persistent folder public/uploads
MEDIA_STORAGE_PROVIDER=local
# MEDIA_BUCKET=my-vib-media-bucket
# MEDIA_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_REGION=auto
# MEDIA_ACCESS_KEY_ID=your_access_key_id
